# OrgaBoard - Konfiguration
#
# Diese Datei nach .env kopieren und ausfuellen. .env ist per .gitignore
# ausgeschlossen und gehoert nicht ins Repository.
#
#   cp .env.example .env

# --- Betriebsmodus -----------------------------------------------------------
# development | staging | production
# Ab staging werden im Repository nachlesbare Secrets abgelehnt.
# In production sind ausserdem JWT_SECRET >= 32 Zeichen und COOKIE_SECURE=true
# zwingend.
ENV=development

# --- Sicherheit --------------------------------------------------------------
# Eigenes Secret erzeugen mit:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Wird dieses Secret bekannt, kann jeder beliebige Sitzungen faelschen -
# einschliesslich der Teamleiter-Rolle.
JWT_SECRET=

# Nur ueber HTTPS ausliefern. In Produktion Pflicht.
COOKIE_SECURE=false

# Sitzungsdauer in Minuten (720 = 12 Stunden).
JWT_EXP_MINUTES=720

# --- Adressen ----------------------------------------------------------------
# Adresse, unter der das Frontend erreichbar ist. Steuert CORS und die
# Basisadresse der Passwort-Reset-Links.
FRONTEND_ORIGIN=http://localhost:8080

# Optional: weitere erlaubte Adressen fuer Reset-Links, kommagetrennt.
# Zum Beispiel eine Codespaces-URL. Nur was hier steht, ist erlaubt - der
# Origin-Header des Requests wird nicht ausgewertet.
PASSWORD_RESET_ALLOWED_ORIGINS=

# --- Datenbank ---------------------------------------------------------------
POSTGRES_PASSWORD=
# Wird von docker-compose.yml zusammengesetzt. Nur setzen, wenn eine externe
# Datenbank genutzt wird.
# DATABASE_URL=postgresql+psycopg://orgaboard:PASSWORT@db:5432/orgaboard

# --- Erstes Anlegen der Konten -----------------------------------------------
# Startpasswort fuer die Seed-Konten. Alle muessen es beim ersten Login aendern.
# Der Seed laeuft nur auf einer leeren Benutzertabelle.
SEED_DEFAULT_PASSWORD=

# Optional: eigene Namensliste als JSON-Datei, Format siehe backend/app/seed.py
# SEED_USERS_FILE=/run/secrets/orgaboard-users.json

# --- Betreiberkonto ----------------------------------------------------------
# E-Mail des Systemadministrators (Inhaber). Beim Start wird genau dieses
# vorhandene Konto auf die hoechste Stufe gehoben. Es gibt keinen Weg, diese
# Rolle ueber die Oberflaeche zu vergeben - das erste Konto muss aus einer
# geschuetzten Quelle kommen. Leer lassen heisst: kein Systemadministrator.
SYSTEM_ADMIN_EMAIL=

# Nur fuer die allererste Anlage: gibt es das Konto oben noch nicht, wird es
# mit diesem Passwort angelegt (mindestens 12 Zeichen). Ein vorhandenes Konto
# wird NICHT ueberschrieben. Nach dem ersten Login kann der Eintrag wieder
# raus - das Konto bleibt bestehen.
SYSTEM_ADMIN_PASSWORD=

# --- E-Mail-Versand (Passwort zuruecksetzen) ---------------------------------
# Ohne SMTP_HOST und SMTP_FROM_EMAIL antwortet der Reset-Endpunkt mit 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_EXP_MINUTES=20

# --- KI-Assistent (optional) -------------------------------------------------
# Ohne API-Key laeuft der lokale Assistent fuer Kernfragen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_OUTPUT_TOKENS=1600
OPENAI_TIMEOUT_SECONDS=45
AI_ENABLED=true

# --- Sonstiges ---------------------------------------------------------------
BUSINESS_TIMEZONE=Europe/Berlin
# Schema per Alembic verwalten; nur fuer schnelle lokale Versuche auf true.
AUTO_CREATE_SCHEMA=false
CHAT_MEDIA_DIR=/data/chat-media
